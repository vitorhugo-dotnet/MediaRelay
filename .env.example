# Discord
DISCORD_ENABLED=true
DISCORD_TOKEN=replace-with-discord-bot-token
DISCORD_APPLICATION_ID=123456789012345678
DISCORD_ALLOWED_GUILD_IDS=

# Default `docker compose` configuration (production app only)
COMPOSE_FILE=deploy/docker-compose.prod.yml

# Container image; use a sha-<40-character-commit-sha> tag for production deployment
IMAGE=ghcr.io/vitorhugo-dotnet/media-relay:latest

# Existing MinIO S3 endpoint for the default production Compose file
MINIO_ENDPOINT=filestorage-minio:9000
MINIO_PUBLIC_ENDPOINT=s3.hugojava.dev
MINIO_BUCKET=media
MINIO_ROOT_USER=replace-with-minio-admin-user
MINIO_ROOT_PASSWORD=replace-with-a-long-minio-admin-password
MINIO_USE_SSL=false
MINIO_PUBLIC_USE_SSL=true

# Public URLs
PUBLIC_MEDIA_BASE_URL=https://s3.hugojava.dev
PUBLIC_APP_BASE_URL=https://upload.hugodotnet.dev

# Upload
UPLOAD_API_KEY=replace-with-random-upload-api-key
MAX_UPLOAD_SIZE=536870912
UPLOAD_SESSION_TTL_MINUTES=30
PRESIGNED_UPLOAD_TTL_MINUTES=15
