{
  "Version": "15.0.0",
  "Name": "MediaRelay",
  "DestinationType": "ImageUploader, FileUploader",
  "RequestMethod": "POST",
  "RequestURL": "https://upload.hugodotnet.dev/api/sharex/upload",
  "Headers": {
    "Authorization": "Bearer %MediaRelayApiKey%"
  },
  "Body": "MultipartFormData",
  "Arguments": {},
  "FileFormName": "file",
  "URL": "$json:url$",
  "ErrorMessage": "$json:detail$"
}
